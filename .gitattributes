# Normalize text; avoid CRLF noise in Rust/Markdown on Windows checkouts.
* text=auto

*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# N64 build inputs run under Linux/WSL toolchains: make rejects CRLF recipes, and
# linker scripts and assembly are read by tools that do not expect it either.
Makefile text eol=lf
*.ld text eol=lf
*.S text eol=lf
