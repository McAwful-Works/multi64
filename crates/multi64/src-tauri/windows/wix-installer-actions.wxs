<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <!--
      Anchor for the fragment. WiX links a Fragment only when something references it, and Tauri
      exposes no `customActionRefs`, so without a referencable element here `light` silently drops
      this whole file: before this group existed, the custom action below never reached the MSI.
      Referenced from tauri.conf.json via `bundle.windows.wix.componentGroupRefs`.
    -->
    <ComponentGroup Id="Multi64InstallerActions" />
    <!--
      `SystemFolder` is a standard MSI directory but is not among the ones Tauri emits into
      main.wxs (TARGETDIR, INSTALLDIR, ProgramMenuFolder, DesktopFolder, ApplicationProgramsFolder),
      so a Type 34 custom action naming it fails to link with LGHT0094. Declare it here.
    -->
    <DirectoryRef Id="TARGETDIR">
      <Directory Id="SystemFolder" Name="System" />
    </DirectoryRef>
    <!--
      Stop `multi64d.exe` before MSI inspects or replaces files. The daemon is a bundled resource,
      not the main binary, so nothing in the default sequence closes it; while it runs it holds
      `resources\multi64d.exe` open and the install (or uninstall) hits a file-in-use error. Mirrors
      NSIS_HOOK_PREINSTALL in windows/installer-hooks.nsh.

      `util:CloseApplication` would be the idiomatic tool, but the WiX util extension is not linked
      into this build, so declaring its namespace here would fail candle. A CustomAction needs no
      extension.

      Sequenced before InstallValidate (the point at which MSI detects files in use) and left
      unconditioned so it runs on uninstall too. Return="ignore" because taskkill exits 128 when no
      such process is running, which is the common case and not an error.
    -->
    <CustomAction Id="Multi64StopDaemon"
      Directory="SystemFolder"
      ExeCommand="taskkill.exe /F /IM multi64d.exe"
      Execute="immediate"
      Impersonate="yes"
      Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="Multi64StopDaemon" Before="InstallValidate" />
    </InstallExecuteSequence>
  </Fragment>
</Wix>
