{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multi64",
  "version": "0.1.0",
  "identifier": "dev.multi64.gui",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Multi64",
        "width": 560,
        "height": 640,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/multi64d.exe",
      "resources/xfer64-setup.exe",
      "resources/xfer64-setup.msi",
      "resources/xfer64-installer-prompt.ps1"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "template": "windows/installer.nsi",
        "installerHooks": "windows/installer-hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["windows/wix-xfer64-option.wxs"],
        "componentGroupRefs": ["Multi64InstallerActions"]
      }
    }
  }
}
