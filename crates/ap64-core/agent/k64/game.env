# Kirby 64: The Crystal Shards (US) seeds of Archipelago's k64 world. Addresses from the
# decomp's splat map (Kirby64Ret/kirby64, kirby64.yaml) and checked against the ROM here.
#
# The stub goes in a 1088-byte run of zeros in the `main` segment's data, which is loaded
# at boot and resident for the whole run -- the hook is in overlay 1, so the stub has to be
# somewhere that is there whenever that overlay is. Nothing in the 32 MiB points into the
# run, and tools/watch-ranges.lua watched those exact bytes through attract mode and a play
# session without one of them changing.
STUB_VRAM=0x8003BD0C
STUB_MAX=1088
# The Expansion Pak is untouched: 0 of 1024 pages across 67,000 frames of attract mode and
# play, and the single instruction in the ROM that forms 0x80400000 is a dead store that
# nothing ever reads back.
AGENT_VRAM=0x80480000
# Past the patch's own data, which ends at 0x1FFF268 with every option at its maximum.
AGENT_ROM=0x2000000
AGENT_MIN_RAM=0x800000
