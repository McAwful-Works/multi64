# Bomberman 64: The Second Attack! (US). Addresses come from the Bomberhackers/bm64tsa decomp's
# symbols. Its boot_code segment is ROM 0x1000 at 0x80000400 and is stored uncompressed, so
# vram = rom + 0x7FFFF400 there; the game's overlays and assets are compressed.
#
# STUB_VRAM is bmLoadBitmapTile. Nothing in the resident code jals, jumps to or stores its
# address, and no addiu/ori anywhere in the ROM has its low half. It is in the game's symbol
# map (ROM 0x280000), through which the compressed overlays link by name, so the scan is
# only a shortlist: measured, 0 calls at its entry, +0x100, +0x200 and +0x300 over 45,420
# frames of play while malloc ran 9,525 times, and none of its 824 bytes ever changed. The
# world's tokens and its ROM adjuster leave 0x8000BC7C..0x8000BFB4 alone.
STUB_VRAM=0x8000BC7C
STUB_MAX=824

# The Expansion Pak. The game never touched a page of it over that session (osMemSize
# 0x800000, 0 of 1024 Pak pages used), while the base 4 MB ran 751 of 1024 pages used.
# ram-bounds.py over the boot code finds nothing bracketing it. The one Pak address the ROM
# builds, 0x80410000, is the world's `lui $gp, 0x8041`, and no resident code addresses
# memory through $gp.
AGENT_VRAM=0x80480000

# Past the end of the AP ROM. The world keeps the retail 16 MB (0x1000000), and its ROM
# adjuster repacks the compressed data inside it (it ended at 0xFEC668 for the measured seed).
AGENT_ROM=0x1000000
AGENT_MIN_RAM=0x800000
