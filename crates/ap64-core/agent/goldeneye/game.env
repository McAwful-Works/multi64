# GoldenEye 007 (US), as patched by NotFamilyJules's Archipelago world (goldeneye_ap, measured
# at main 21302eb1). Addresses come from the n64decomp/007 decomp, whose ge007.u.sha1 is this
# ROM's. Both code segments are uncompressed: boot/lib code at ROM 0x1000 runs at 0x70000400,
# and the game code at ROM 0x34B30 runs at 0x7F000000, both TLB-mapped. The mappings were
# confirmed by where call targets land, not assumed.
#
# STUB_VRAM is in the boot/lib segment, which stays resident. The game segment (0x7F000000)
# is not: GoldenEye demand-pages it through the TLB, 8 KB at a time from ROM into a pool of
# 90 pages (tlb_manage.c), so a stub there loses whatever it writes when its page is
# recycled. One was tried there, over title2.c's unreferenced sub_GAME_7F01B6E0, and froze
# the game at its first stage change.
#
# 0x7001F38C (ROM 0x1FF8C) is a libultra Controller Pak file function: it opens by checking
# and clearing OSPfs.activebank (offset 0x65) and calls __osPfsSelectBank, and GoldenEye
# saves to EEPROM. No jal or j reaches it, no lui/addiu or lui/ori pair builds its address,
# and no word in the ROM equals it, including the world's payload. Measured too, with the
# world's own Lua running: 0 executions at its entry, +0x100 and +0x200 over 8,280 frames of
# menus, missions, pickups, a death and debriefs, while the hook site ran 5,042 times. The
# same scan's other candidate in this segment, 0x70019C84, ran 2,112 times through some
# computed address: the count is the proof, not the scan. The world leaves all 800 bytes
# alone.
STUB_VRAM=0x7001F38C
STUB_MAX=800

# The Expansion Pak, which this world needs anyway: it moves the game's stacks and buffers up
# 4 MB, to 0x807B.../0x807E.... Over that session 0x80400000..0x806A2000 was never touched,
# ram-bounds.py over both code segments and the world's payload finds no address built
# within 3 MB of 0x80480000, and GoldenEye never reads osMemSize: it is built for a fixed
# 4 MB, so no heap grows into the Pak.
AGENT_VRAM=0x80480000

# Past the end of the 12 MB image; the world's own data ends at 0xBFF83C.
AGENT_ROM=0xC00000

# The world needs the Pak for the game itself; without one the stub skips the agent.
AGENT_MIN_RAM=0x800000
