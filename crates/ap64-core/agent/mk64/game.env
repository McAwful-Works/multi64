# Mario Kart 64 (US). Addresses come from the n64decomp/mk64 decomp, whose mk64.us.sha1
# (579c48e2...) is the retail ROM this profile was measured against, so vram = rom +
# 0x7FFFF400 and the function names below are the decomp's.
#
# STUB_VRAM is two adjacent functions that nothing in the ROM jals to, that no lui+addiu
# pair anywhere in the four code segments builds a pointer into, and that each begin with
# a real `addiu $sp,$sp,-N` prologue -- so they are entries, not the tail half of a
# function with two epilogues, which would be unreferenced for a boring reason. Measured
# at 0 calls over 55,890 frames of varied play while three controls climbed. A name would
# not have done: DKR's debug_text_print reads as dead code and runs every frame.
STUB_VRAM=0x8003DC50
STUB_MAX=1016

# The Expansion Pak. Every candidate in the base 4 MB is bracketed by a pair of computed
# addresses, and base RAM runs 86-88% used. 0x80750000 sits above the 0x80500000..0x80744000
# pair, is the only candidate ram-bounds.py finds nothing bracketing, and measured
# never-written across 185,250 frames with Archipelago live.
#
# Do NOT move this into the big 0x80501000..0x80744000 run. It measures free and is not:
# its bounds are built by code, which is how a heap's extent is written. That is exactly
# the shape that made Legacy of Darkness freeze.
AGENT_VRAM=0x80750000

# Appended past the 16 MiB image the AP basepatch produces. The basepatch extends the
# 12 MiB retail ROM to 0x1000000 and a seed writes only 0xC00000..0xC03757 of it, at
# maximum options -- so nothing of the randomizer's reaches here.
AGENT_ROM=0x1000000
AGENT_MIN_RAM=0x800000

# UNRESOLVED: whether MK64-AP itself needs an Expansion Pak. The randomizer's own block
# lives at 0x80400000 and its hook jumps to 0x80404180, neither of which exists on a 4 MB
# console. BizHawk cannot answer this -- it keeps an 8 MB RDRAM domain even with the
# Expansion Slot disabled, so the game reads osMemSize=0x400000 while that memory is still
# really there, and a 4 MB run looks fine. Settle it by booting MK64-AP on a console with
# the Pak physically removed. AGENT_MIN_RAM only makes the *agent* stand down below 8 MB.
