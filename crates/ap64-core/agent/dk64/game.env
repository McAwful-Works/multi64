# Donkey Kong 64 (US), as the DK64 randomizer builds it (dk64.apworld v1.5.8, ROM made on
# dk64randomizer.com). Function names are from Rainchus/Donkey-Kong-64-Recompiled's
# DK64Syms/dump.toml (vanilla US). The randomizer keeps the layout, and every address used
# here was checked byte-for-byte between the seed ROM and a live RAM dump. Full record: #309.
#
# Two ROM-to-RAM mappings, and both matter below:
#   boot segment (dk64_boot, 0x80000450..0x80010720): vram = rom + 0x7FFFF400
#   main code (global_asm, from 0x805FB300): vram = rom + 0x7E5C1540. Vanilla gzips it
#     at ROM 0x113F0; the randomizer ships it uncompressed past 32 MB and loads it raw.
#
# STUB_VRAM is libultra's Controller Pak code: __osRepairPackId, __osCheckPackId and
# __osGetId, 0x8000D180..0x8000D7E0, contiguous. DK64 saves to EEPROM. __osGetId has no
# caller anywhere in the loaded code, and the other two are called only from it. Counted
# at 0 executions of any instruction in the range over 37,800 video frames of varied play
# (interpreter core, whole-range exec hook), while an osRecvMesg range ran 40 million
# instructions. The boot segment stays resident: mode overlays load at 0x80024000, above
# it. guLookAtHiliteF looks just as dead from its single static caller and ran 8 million
# instructions over the same session. Don't pick stub space by name.
STUB_VRAM=0x8000D180
STUB_MAX=1632

# DK64 uses all 8 MB: over 164,700 frames with Archipelago live, every base page and 1003
# of 1024 Expansion Pak pages were touched, and no untouched run fit the agent. So the RAM
# is made instead. The heap setup (func_global_asm_80610388) takes 0x805C1040 as the top
# of its arena, at 0x80610510/0x80610518, carves its fixed buffers downward from there,
# and the heap ends below them. That constant is exactly where the randomizer's own code
# starts; the randomizer made room for itself this way. The profile lowers it by 32 KB to
# 0x805B9040, and the agent lives in the gap. A register-tracking scan finds nothing that
# builds an address in the gap (its control range found 51). With the lowered top, over
# 121,920 frames:
#   - the heap's low point was 739 KB free, with a largest block of 504 KB, in Frantic
#     Factory, so the 32 KB is about 4% of the worst seen;
#   - the gap stayed all zero in 4,064 of 4,064 samples, with a live control;
#   - 0x805BA000..0x805C1000 was never touched.
# AGENT_VRAM is the start of that last run, page-aligned, rather than the gap's start: the
# gap's first page is shared with the buffer below it.
#
# Do NOT use the randomizer's untouched 0x805D6000..0x805D9000 instead. It is the top of
# music_storage (base-hack init.c), handed to the game at boot as its sequence buffer;
# only the songs heard so far were too small to reach it.
AGENT_VRAM=0x805BA000

# Appended past the randomizer's image, which ends at 0x34013A8 (52 MB).
AGENT_ROM=0x3402000

# DK64 does not boot without an Expansion Pak, so this is a formality.
AGENT_MIN_RAM=0x800000
