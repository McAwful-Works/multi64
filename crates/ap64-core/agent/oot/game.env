# Ocarina of Time (NTSC 1.0) seeds of Archipelago's OoT world (OoTR payload).
# The seed is decompressed first. The game's own payload loader is pointed at a new file
# holding the seed's payload, then this stub, then the agent with its BSS as zeros, so the
# agent is loaded at boot with the payload, right after it in RAM (where oot-ap-cart's
# agent ran on hardware). AGENT_ROM is the new file's vrom plus the agent's offset in it.
STUB_VRAM=0x80461C40
STUB_MAX=960
AGENT_VRAM=0x80462000
AGENT_ROM=0x3582000
AGENT_MIN_RAM=0x0
