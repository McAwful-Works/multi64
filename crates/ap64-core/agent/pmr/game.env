# Paper Mario (US 1.0) with the Paper Mario Randomizer. The stub goes over
# update_camera_unused_ahead (0x8002FCE0, ROM 0xB0E0, 800 B), which vanilla never calls.
# The agent goes past the randomizer's base mod, which fills ROM to 0x2AE40C0 and RAM
# 0x80400000-0x8046F140; 0x80470000-0x804C0000 was measured untouched during play.
STUB_VRAM=0x8002FCE0
STUB_MAX=800
AGENT_VRAM=0x80480000
AGENT_ROM=0x2B00000
AGENT_MIN_RAM=0x800000
