# Bomberman 64 (US). Addresses come from the bomberhackers/bm64 decomp. Its splat.yaml maps
# main_code as ROM 0x40000 at 0x80225800, and Archipelago's world writes its own routines by
# the same mapping (its 0x922F8 is 0x80277AF8), so vram = rom + 0x801E5800 in main_code.
# The retail ROM keeps main_code uncompressed; only the overlays past 0x120000 are packed.
#
# STUB_VRAM is memalign from the game's copy of GNU malloc (src/libmalloc/gmalloc.c).
# Nothing in the uncompressed ROM jals to it except valloc, and nothing jals to valloc or
# builds a pointer to either. The overlays are compressed and cannot be read that way, so
# it was also measured: 0 calls at its entry, +0x98 and +0x1A0, and at valloc's entry, over
# 41,940 frames of play while malloc ran 167,420 times, and its 488 bytes never changed.
# The RAM copy matched ROM 0xB5C68 byte for byte, so the stub written there is what runs.
# The randomizer leaves 0x80299370..0x8029B650 (the whole of gmalloc) alone.
STUB_VRAM=0x8029B468
STUB_MAX=488

# The Expansion Pak. The game never touched a page of it over that session (osMemSize
# 0x800000, 0 of 1024 Pak pages used), while the base 4 MB ran 687 of 1024 pages used.
# ram-bounds.py over the boot code and main_code finds nothing bracketing it: the highest
# address either builds is 0x80300000.
AGENT_VRAM=0x80480000

# Past the end of the AP ROM. The world's bsdiff produces 0x7B7668 bytes for every seed
# (the retail ROM with its zero tail cut off), and nothing a seed writes reaches past that.
AGENT_ROM=0x800000
AGENT_MIN_RAM=0x800000
