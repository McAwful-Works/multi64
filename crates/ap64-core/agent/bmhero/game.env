# Bomberman Hero (US). Addresses come from the Bomberhackers/bmhero decomp, whose splat.yaml
# pins this ROM's sha1. Its boot_code segment is ROM 0x1000 at 0x80000400 and holds the whole
# engine loop, so vram = rom + 0x7FFFF400 there. Nothing in this ROM is compressed on the way
# to RAM: every segment and overlay is DMA'd raw, so a scan of the ROM is a scan of the code.
#
# STUB_VRAM is Debug_BackupMemTest (src/boot/cont_pak.c), a leftover backup-memory test
# screen. Nothing in the ROM jals to it, jumps to it, builds its address with lui/addiu or
# stores it as a word, and the same holds for Debug_BackupMemTest_Menu after it. Measured
# too: 0 calls at its entry, +0x100 and +0x200 and at the menu's entry over 57,210 frames
# of play while malloc ran 247,055 times, and none of its 756 bytes ever changed. The
# randomizer's tokens leave 0x80020550..0x80020844 alone.
STUB_VRAM=0x80020550
STUB_MAX=756

# The Expansion Pak. The game never touched a page of it over that session (osMemSize
# 0x800000, 0 of 1024 Pak pages used), while the base 4 MB ran 771 of 1024 pages used.
# main() clears RAM only up to 0x80400000, and ram-bounds.py over the boot code and the game
# segment finds nothing bracketing it: the highest address either builds is 0x80400000.
AGENT_VRAM=0x80480000

# Past the end of the AP ROM. The world patches with tokens only, so the ROM keeps the retail
# 12 MB (0xC00000); its last write is the slot name at 0xB86500.
AGENT_ROM=0xC00000
AGENT_MIN_RAM=0x800000
