{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xfer64",
  "version": "0.1.0",
  "identifier": "dev.multi64.xfer64",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Xfer64",
        "width": 1100,
        "height": 700,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "dev-shell",
        "title": "Xfer64 — developer log",
        "url": "dev-shell.html",
        "width": 920,
        "height": 560,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "upload-picker",
        "title": "Xfer64 — Quick upload",
        "url": "upload-picker.html",
        "width": 440,
        "height": 480,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["windows/wix-sendto-uninstall.wxs"]
      }
    }
  }
}
