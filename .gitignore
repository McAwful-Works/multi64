/target
**/*.rs.bk

# OS / editor noise
.DS_Store
Thumbs.db
.idea/

# Local tooling checkouts (optional; not part of this tree)
_ap_clone/

# Python (scripts + venv)
scripts/venv/
**/__pycache__/
*.pyc

# Secrets / local env (never commit)
.env
.env.*

# Tauri frontends: npm + bundled daemon during dev/build
crates/multi64/node_modules/
crates/multi64/src-tauri/resources/multi64d.exe
# Written by src-tauri/build.rs on every build (real payload or 0-byte placeholder).
crates/multi64/src-tauri/resources/xfer64-setup.exe
crates/multi64/src-tauri/resources/xfer64-setup.msi
crates/xfer64/node_modules/
crates/xfer64/e2e/node_modules/
crates/multi64-test-connector-gui/node_modules/

# Claude Code: per-developer permission grants (CLAUDE.md itself is tracked)
.claude/settings.local.json

# N64 ROM intermediates. These embed the builder absolute paths, so they churn
# for every person who rebuilds. The shipped multi64_test.z64 stays tracked: it
# is built from the stripped elf and is byte-reproducible from n64/toolchain.lock.
n64/test-rom/build/
